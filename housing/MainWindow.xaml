<Window x:Name="InfoHousingForm" x:Class="housing.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:housing"
        mc:Ignorable="d"
        Title="Інформація про житло" Height="500" Width="382" Icon="/housing.ico" Loaded="InfoHousingForm_Loaded" Activated="InfoHousingForm_Activated" ResizeMode="NoResize">
    <Grid>
        <Menu x:Name="MainManu" BorderThickness="1,1,1,1">
            <MenuItem x:Name="FileMenuItem" Header="Файл" Click="FileMenuItem_Click">
                <MenuItem x:Name="LoadDataMenuItem" Header="Завантажити" Click="LoadDataMenuItem_Click"/>
                <MenuItem x:Name="SaveDataMenuItem" Header="Зберегти" Click="SaveDataMenuItem_Click"/>
            </MenuItem>
            <MenuItem x:Name="HousingMenuItem" Header="Житло" Click="HousingMenuItem_Click">
                <MenuItem x:Name="EditDataMenuItem" Header="Редагувати"/>
                <MenuItem x:Name="AddDataMenuItem" Header="Додати"/>
            </MenuItem>
            <MenuItem x:Name="SelectMenuItem" Header="Пошук" Click="SelectMenuItem_Click">
                <MenuItem x:Name="SelectXMenuItem" Header="За прізвищем"/>
                <MenuItem x:Name="SelectXYMenuItem" Header="За житловою площею"/>
            </MenuItem>
            <MenuItem x:Name="AuthMenuItem" Header="Авторизація" Click="AuthMenuItem_Click"/>
        </Menu>
        <DataGrid x:Name="HousingListDG" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="5,30,20,10" VerticalAlignment="Top" AutoGenerateColumns="False" ItemsSource="{Binding}" IsReadOnly="True" CanUserReorderColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding id}"/>
                <DataGridTextColumn Header="Прізвище" Binding="{Binding surname}"/>
                <DataGridTextColumn Header="Адреса" Binding="{Binding adress}"/>
                <DataGridTextColumn Header="Площа" Binding="{Binding area}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
