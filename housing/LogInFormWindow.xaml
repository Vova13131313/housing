<Window x:Name="LogInForm" x:Class="housing.LogInFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:housing"
        mc:Ignorable="d"
        Title="Авторизація" Height="140" Width="260" WindowStyle="ToolWindow" KeyDown="LogInForm_KeyDown" Closing="LogInForm_Closing" ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="20, 0, 0, 0">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60"/>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="40"/>
        </Grid.ColumnDefinitions>
        <Label x:Name="logLabel" Grid.Column="0" Content="Логін" HorizontalAlignment="Left" Margin="10, 0, 0, 0"/>
        <TextBox x:Name="logTextBox" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center"/>
        <Label x:Name="passwordLabel" Grid.Row="1" Grid.Column="0" Content="Пароль" HorizontalAlignment="Left" Margin="10, 0, 0, 0"/>
        <TextBox x:Name="passwordTextBox" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"/>
        <Button x:Name="okButton" Grid.Row="2" Grid.Column="2" Content="Вхід" Width="40" Height="20" Margin="0,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="okButton_Click"/>
    </Grid>
</Window>